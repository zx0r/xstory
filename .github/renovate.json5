// =============================================================================
// DEPENDENCY AUTOMATION & SUPPLY CHAIN SECURITY SPECIFICATION
// =============================================================================
// Standard: OpenSSF Scorecard L4 · Hermetic Toolchain · SLSA Level 3
// Role: Autonomous Dependency Guardian & Automated Cryptographic Pinning
// Target: xstory (.github/workflows/*.yml & Cargo ecosystem)
// =============================================================================

{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Enterprise CI/CD & Rust Hermetic Toolchain Automation",
  configMigration: false,

  // ---------------------------------------------------------------------------
  // 1. Core Presets & Security Baselines
  // ---------------------------------------------------------------------------
  extends: [
    // Curated production configuration recommended by Renovate core team
    "config:best-practices",
    // OpenSSF Scorecard L4 Mandate: automatically pins 40-character commit SHAs
    // for all GitHub Actions while generating human-readable version annotations
    "helpers:pinGitHubActionDigests",
    // Enforces Conventional Commits (feat:, fix:, chore:) for automated release notes
    ":semanticCommits",
    // Generates an interactive GitHub Issue dashboard for workflow visibility
    ":dependencyDashboard",
  ],

  timezone: "UTC",
  // Execute scheduled dependency sweeps during low-traffic maintenance window
  schedule: ["before 06:00 on monday"],

  // ---------------------------------------------------------------------------
  // 2. Supply Chain Defense & Blast Radius Quarantine
  // ---------------------------------------------------------------------------
  // THREAT MODEL: Credential theft, account takeovers, or typosquatting on crates.io
  // or GitHub Marketplace. Empirically, > 95% of malicious packages are discovered,
  // reported, and revoked within 48 to 72 hours of publication.
  // INVARIANT: All non-security updates are quarantined for 72 hours before PR creation.
  minimumReleaseAge: "3 days",
  internalChecksAsSuccess: true,

  // ZERO-DAY EXCEPTION: Immediately bypass quarantine for known CVEs & RustSec advisories
  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: "0 days",
    labels: ["security", "priority:critical"],
  },

  // ---------------------------------------------------------------------------
  // 3. Custom Datasource: Official Rustup Miri Component Availability Index
  // ---------------------------------------------------------------------------
  // PROBLEM: In Rust Nightly, compiler internal refactorings frequently prevent
  // Miri from compiling. Naive date bumping (nightly-YYYY-MM-DD) results in broken CI
  // runs with "component 'miri' is unavailable for toolchain".
  // ARCHITECTURE: Query the official Rustup components tracking repository.
  // JSONata extracts the latest verified working date (`last_available`), guaranteeing
  // that Renovate ONLY proposes toolchains where Miri is packaged and ready to install.
  customDatasources: {
    "rustup-miri-history": {
      defaultRegistryUrlTemplate: "https://rust-lang.github.io/rustup-components-history/x86_64-unknown-linux-gnu/miri.json",
      format: "json",
      transformTemplates: [
        // JSONata expression: maps last_available date into a virtual release object
        "{\"releases\": [{\"version\": \"nightly-\" & last_available}]}",
      ],
    },
  },

  // ---------------------------------------------------------------------------
  // 4. Custom Managers: Regex Extraction for Workflow Variables & CLI Binaries
  // ---------------------------------------------------------------------------
  customManagers: [
    {
      // 4.1. Rust Developer Utilities in taiki-e/install-action
      // CONTRACT: Supports comma-separated tool lists (e.g. tool: "cargo-nextest@0.9.92,cargo-llvm-cov@0.6.16")
      // Non-greedy capture updates each crate independently without clobbering neighboring tools
      customType: "regex",
      description: "Update pinned Rust CLI developer binaries in taiki-e/install-action",
      managerFilePatterns: ["/\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: [
        "(?<depName>cargo-[a-z0-9_-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      datasourceTemplate: "crate",
      versioningTemplate: "semver",
    },
    {
      // 4.2. Pinned Nightly Miri Toolchain Date
      // CONTRACT: Updates MIRI_NIGHTLY variable in CI workflow env block
      // MAPPING: Regex versioning translates "nightly-YYYY-MM-DD" into major=YYYY, minor=MM, patch=DD,
      // allowing standard semver comparison engines to evaluate chronological release order
      customType: "regex",
      description: "Update MIRI_NIGHTLY to the latest verified nightly containing the miri component",
      managerFilePatterns: ["/\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: [
        "MIRI_NIGHTLY:\\s*[\"'](?<currentValue>nightly-\\d{4}-\\d{2}-\\d{2})[\"']",
      ],
      depNameTemplate: "rust-miri-nightly",
      datasourceTemplate: "custom.rustup-miri-history",
      versioningTemplate: "regex:^nightly-(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$",
    },
  ],

  // ---------------------------------------------------------------------------
  // 5. Package Rules: Atomic Batches
  // ---------------------------------------------------------------------------
  packageRules: [
    {
      // Group all weekly GitHub Actions and developer toolchain updates into a single PR
      // Reduces CI compute load, avoids PR notification fatigue, and tests interoperability
      description: "Group GitHub Actions SHA digests and CI CLI tools into a single weekly PR",
      matchManagers: ["github-actions", "custom.regex"],
      groupName: "ci-toolchain-and-actions",
      groupSlug: "ci-toolchain",
      labels: ["ci", "dependencies"],
    },
  ],
}
